{
  "name": "thoughtfull-booking",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "build": "npm run build -w backend",
    "dev": "npm run dev -w backend",
    "start": "npm run start -w backend",
    "test": "vitest run",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "lint": "eslint . && npm run format:check",
    "lint:fix": "eslint . --fix && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "^26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
