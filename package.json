{
  "name": "thoughtfull-booking",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w backend",
    "dev": "npm run dev -w backend",
    "start": "npm run start -w backend",
    "test": "vitest run",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "lint": "eslint . && npm run lint -w frontend && npm run format:check",
    "lint:fix": "eslint . --fix && npm run lint -w frontend -- --fix && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "npm run db:seed -w backend",
    "dev:web": "npm run dev -w frontend",
    "build:web": "npm run build -w frontend",
    "typecheck:web": "npm run typecheck -w frontend",
    "gen:api": "npm run build && node backend/scripts/export-openapi.cjs && npm run gen:api -w frontend",
    "test:browser": "npm run test:browser -w frontend",
    "audit:security": "npm audit --audit-level=high"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.5",
    "glob@>=9 <14.0.2": "^14.0.4",
    "esbuild": "^0.28.2"
  }
}
